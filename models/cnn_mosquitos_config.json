  "class_ids": {
    "Aedes aegypti": 0,
    "Aedes albopictus": 1,
    "Culex": 2
  },
  "output_activation": "softmax",
  "validation_f1_macro": 0.9262,
  "validation_accuracy": 0.9223,
  "notes": "Clasificador de mosquitos adultos. Para mejores resultados, el mosquito debe ser claramente visible y ocupar una parte relevante de la imagen. El modelo no diagnostica dengue en personas."
